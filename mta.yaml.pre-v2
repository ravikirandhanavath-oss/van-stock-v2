_schema-version: 3.3.0
ID: van-stock-v2
description: Van Stock Profile v2 - standalone approuter
version: 1.0.0

modules:

- name: van-stock-v2-srv
  type: nodejs
  path: gen/srv
  requires:
  - name: van-stock-v2-auth
  - name: van-stock-v2-db
  - name: van-stock-v2-destination
  provides:
  - name: srv-api
    properties:
      srv-url: ${default-url}
  parameters:
    buildpack: nodejs_buildpack
    instances: 1
    memory: 512M
    disk-quota: 1024M
  build-parameters:
    builder: npm-ci

- name: van-stock-v2-db-deployer
  type: hdb
  path: gen/db
  requires:
  - name: van-stock-v2-db
  parameters:
    buildpack: nodejs_buildpack
    memory: 256M

- name: van-stock-v2-router
  type: approuter.nodejs
  path: app/router
  requires:
  - name: srv-api
    group: destinations
    properties:
      forwardAuthToken: true
      name: srv-api
      url: ~{srv-url}
  - name: van-stock-v2-auth
  - name: van-stock-v2-html5-runtime
  - name: van-stock-v2-destination
  provides:
  - name: app-api
    properties:
      app-protocol: ${protocol}
      app-uri: ${default-uri}
  parameters:
    disk-quota: 512M
    keep-existing-routes: true
    memory: 256M

- name: van-stock-v2-app-deployer
  type: com.sap.application.content
  path: gen
  requires:
  - name: van-stock-v2-auth
  - name: srv-api
  - name: van-stock-v2-html5-repo-host
    parameters:
      config:
        HTML5Runtime_enabled: true
      content-target: true
  parameters:
    config:
      destinations:
      - Authentication: NoAuthentication
        DynamicDestination: true
        ForwardAuthToken: true
        Name: srv-api
        ProxyType: Internet
        Type: HTTP
        URL: ~{srv-api/srv-url}
  build-parameters:
    build-result: app/
    requires:
    - artifacts:
      - comvanstockv2.zip
      name: comvanstockv2
      target-path: app/

- name: comvanstockv2
  type: html5
  path: app/vanstockprofile
  build-parameters:
    build-result: dist
    builder: custom
    commands:
    - npm install
    - npm run build:cf
    supported-platforms: []

- name: van-stock-v2-destinations
  type: com.sap.application.content
  requires:
  - name: van-stock-v2-auth
    parameters:
      service-key:
        name: van-stock-v2-auth-key
  - name: van-stock-v2-html5-repo-host
    parameters:
      service-key:
        name: van-stock-v2-html5-repo-host-key
  - name: srv-api
  - name: van-stock-v2-destination
    parameters:
      content-target: true
  parameters:
    content:
      instance:
        destinations:
        - Name: van-stock-v2-html5-repository
          ServiceInstanceName: van-stock-v2-html5-repo-host
          ServiceKeyName: van-stock-v2-html5-repo-host-key
          sap.cloud.service: vanstockv2.service
        - Authentication: OAuth2UserTokenExchange
          Name: van-stock-v2-auth
          ServiceInstanceName: van-stock-v2-auth
          ServiceKeyName: van-stock-v2-auth-key
          sap.cloud.service: vanstockv2.service
        existing_destinations_policy: update
  build-parameters:
    no-source: true

resources:

- name: van-stock-v2-auth
  type: org.cloudfoundry.managed-service
  parameters:
    config:
      oauth2-configuration:
        credential-types:
        - binding-secret
        - x509
        redirect-uris:
        - https://*~{app-api/app-uri}/**
      tenant-mode: dedicated
      xsappname: van-stock-v2-${org}-${space}
    path: ./xs-security.json
    service: xsuaa
    service-plan: application
  requires:
  - name: app-api

- name: van-stock-v2-db
  type: com.sap.xs.hdi-container
  parameters:
    service: hana
    service-plan: hdi-shared

# No init_data on purpose: the trial destination-service broker rejects a
# SECOND instance that carries init_data. The subaccount-level "ui5"
# destination already exists and is readable from here.
- name: van-stock-v2-destination
  type: org.cloudfoundry.managed-service
  parameters:
    config:
      HTML5Runtime_enabled: true
    service: destination
    service-plan: lite
  requires:
  - name: srv-api

- name: van-stock-v2-html5-repo-host
  type: org.cloudfoundry.managed-service
  parameters:
    service: html5-apps-repo
    service-plan: app-host

- name: van-stock-v2-html5-runtime
  type: org.cloudfoundry.managed-service
  parameters:
    service: html5-apps-repo
    service-plan: app-runtime

parameters:
  deploy_mode: html5-repo
  enable-parallel-deployments: true

build-parameters:
  before-all:
  - builder: custom
    commands:
    - npm install
    - npx cds build --production
