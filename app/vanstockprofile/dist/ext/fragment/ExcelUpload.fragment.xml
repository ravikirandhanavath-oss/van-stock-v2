<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:u="sap.ui.unified">

    <Dialog
        id="excelUploadDialog"
        title="Upload Excel"
        contentWidth="500px">

        <content>
            <VBox class="sapUiSmallMargin">
                <u:FileUploader
                    id="excelFileUploader"
                    fileType="xlsx"
                    placeholder="Choose Excel file..."
                    change=".onFileChange" />

                <Label id="scenarioLabel" text="Scenario" design="Bold" class="sapUiSmallMarginTop" />
                <RadioButtonGroup id="scenarioGroup" columns="3" select=".onScenarioSelect">
                    <RadioButton id="scenarioProfileRadio" text="Profile" selected="true" />
                    <RadioButton id="scenarioReturnRadio" text="Return" />
                    <RadioButton id="scenarioLeaverRadio" text="Leaver" />
                </RadioButtonGroup>
                <Text id="scenarioHint" class="sapUiTinyMarginTop" text="Columns: Engineer ID | Profit Center | Part Number | Quantity | Value" />
                <Label id="uploadModeLabel" text="Upload Mode" design="Bold" class="sapUiSmallMarginTop" />
                <RadioButtonGroup id="uploadModeGroup" columns="1" class="sapUiSmallMarginTop">
                    <RadioButton id="chunkModeRadio" text="Upload in chunks" selected="true" />
                    <RadioButton id="noChunkModeRadio" text="Upload entire file in one request" />
               <RadioButton id="fullStreamModeRadio" text="Upload entire file and stream process" />
                </RadioButtonGroup>
            </VBox>
        </content>

        <beginButton>
            <Button id="uploadButton" text="Upload" type="Emphasized" press=".onUpload" />
        </beginButton>

        <endButton>
            <Button id="cancelButton" text="Cancel" press=".onCancel" />
        </endButton>

    </Dialog>

</core:FragmentDefinition>